
<launch>
  <node pkg="ira_laser_tools" type="laserscan_multi_merger" name="laser_merger" output="screen">
    <param name="destination_frame" value="base_link"/>
    <param name="destination_topic" value="/scan_multi"/>
    <param name="cloud_destination_topic" value="/merged_cloud"/>
    <param name="laserscan_topics" value="/robot_frasky/husky/front/scan /robot_frasky/husky/rear/scan"/>
  </node>
</launch>
